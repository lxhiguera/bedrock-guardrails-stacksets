{
  "stackset_name": "bedrock-guardrails-baseline",
  "permission_model": "SERVICE_MANAGED",
  "auto_deployment": {
    "Enabled": true,
    "RetainStacksOnAccountRemoval": false
  },
  "call_as": "DELEGATED_ADMIN",
  "environments": {
    "dev": {
      "organizational_unit_ids": ["ou-xxxx-dev00000"],
      "regions": ["us-east-1"],
      "parameters": {
        "Environment": "dev",
        "ContentFilterStrength": "MEDIUM",
        "EnablePromptAttackFilter": "true",
        "KmsKeyArn": ""
      }
    },
    "qa": {
      "organizational_unit_ids": ["ou-xxxx-qa000000"],
      "regions": ["us-east-1"],
      "parameters": {
        "Environment": "qa",
        "ContentFilterStrength": "HIGH",
        "EnablePromptAttackFilter": "true",
        "KmsKeyArn": ""
      }
    },
    "prod": {
      "organizational_unit_ids": ["ou-xxxx-prod0000"],
      "regions": ["us-east-1", "us-west-2"],
      "parameters": {
        "Environment": "prod",
        "ContentFilterStrength": "HIGH",
        "EnablePromptAttackFilter": "true",
        "KmsKeyArn": ""
      }
    }
  },
  "operation_preferences": {
    "RegionConcurrencyType": "PARALLEL",
    "FailureTolerancePercentage": 10,
    "MaxConcurrentPercentage": 25
  }
}
